{%- set headTitle = "Glossary" -%}
{%- set headLede = "Plain definitions of the terms used in New Zealand privacy law and online safety. Each links to the page that explains it in full." -%}
{%- set headFacts -%}<div><dt>Terms</dt><dd>{{ glossary | length }}</dd></div><div><dt>Checked</dt><dd>{{ checked | nzDate }}</dd></div>{%- endset -%}
{% include "partials/page-head.njk" %}
<section class="band tight" aria-label="Jump to a term">
  <ul class="glossary-index">
  {% for t in glossary %}<li><a href="#{{ t.id }}">{{ t.term }}</a></li>{% endfor %}
  </ul>
</section>
<section class="band" aria-label="Definitions">
  <dl class="glossary">
  {% for t in glossary %}
    <div><dt id="{{ t.id }}">{{ t.term }}</dt>
    <dd><p>{{ t.short }} {{ t.long }}</p><p><a href="{{ t.link }}">Read more</a></p></dd></div>
  {% endfor %}
  </dl>
</section>
